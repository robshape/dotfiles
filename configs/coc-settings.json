{
  "astro.useWorkspaceTsdk": true,
  "bashIde.backgroundAnalysisMaxFiles": 0,
  "bashIde.shellcheckPath": "",
  "coc.preferences.formatOnSave": true,
  "colors.enable": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true,
  },
  "eslint.run": "onSave",
  "git.realtimeGutters": false,
  "go.goplsOptions": {
    "gofumpt": true,
    "staticcheck": true
  },
  "json.schemaDownload.trustedDomains": {
    "https://json.schemastore.org": true,
    "https://pi.dev": true,
    "https://raw.githubusercontent.com": true
  },
  "markdownlint.onChange": false,
  "markdownlint.onOpen": false,
  "prettier.onlyUseLocalVersion": true,
  "prettier.requireConfig": true,
  "pyright.organizeimports.provider": "ruff",
  "pyright.testing.provider": "pytest",
  "python.formatting.provider": "ruff",
  "python.linting.ruffEnabled": true,
  "ruff.autoFixOnSave": true,
  "ruff.configurationPreference": "filesystemFirst",
  "stylelintplus.autoFixOnSave": true,
  "stylelintplus.cssInJs": true,
  "stylelintplus.validateOnSave": true,
  "stylelintplus.validateOnType": false,
  "svelte.enable-ts-plugin": false,
  "tailwindCSS.headwind.runOnSave": true
}
